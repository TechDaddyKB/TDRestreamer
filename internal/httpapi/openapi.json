  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tdr_session"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Principal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "streamer",
              "operator",
              "viewer"
            ]
          },
          "edit_granted": {
            "type": "boolean"
          }
        },
        "required": [
          "user_id",
          "tenant_id",
          "role",
          "edit_granted"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "idle",
              "preparing",
              "waiting",
              "testing",
              "armed",
              "starting",
              "live",
              "degraded",
              "stopping",
              "ended",
              "failed"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "test",
              "live"
            ]
          },
          "revision": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "name",
          "state",
          "mode",
          "revision",
          "created_at",
          "updated_at"
        ]
      },
      "Rectangle": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 2
          },
          "height": {
            "type": "integer",
            "minimum": 2
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ]
      },
      "Media": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 2
          },
          "height": {
            "type": "integer",
            "minimum": 2
          },
          "fps": {
            "type": "integer",
            "minimum": 1
          },
          "video_codec": {
            "type": "string"
          },
          "audio_codec": {
            "type": "string"
          },
          "audio_tracks": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "width",
          "height",
          "fps",
          "video_codec",
          "audio_codec",
          "audio_tracks",
          "verified"
        ]
      },
      "Target": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "input_id": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 2,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "minimum": 2,
            "maximum": 8192
          },
          "fps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "bitrate_kbps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200000
          },
          "video_codec": {
            "type": "string"
          },
          "audio_codec": {
            "type": "string"
          },
          "audio_track": {
            "type": "integer",
            "minimum": 0
          },
          "transform": {
            "type": "string",
            "enum": [
              "none",
              "crop",
              "fill",
              "blur"
            ]
          },
          "crop": {
            "$ref": "#/components/schemas/Rectangle"
          },
          "allow_transcode": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "input_id",
          "width",
          "height",
          "fps",
          "bitrate_kbps",
          "video_codec",
          "audio_codec",
          "audio_track",
          "allow_transcode"
        ]
      },
      "PlanRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "$ref": "#/components/schemas/Media"
          },
          "targets": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Target"
            }
          },
          "rule_revision": {
            "type": "string",
            "enum": [
              "generic-v1"
            ]
          }
        },
        "required": [
          "input",
          "targets",
          "rule_revision"
        ]
      },
      "Plan": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_revision": {
            "type": "string"
          },
          "renditions": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "destination_id": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "unsupported",
                    "not_verified",
                    "direct_copy",
                    "audio_conversion",
                    "video_conversion"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "rendition_id": {
                  "type": "string"
                }
              },
              "required": [
                "destination_id",
                "category",
                "reason"
              ]
            }
          }
        },
        "required": [
          "rule_revision",
          "renditions",
          "results"
        ]
      }
    }
  }
}
