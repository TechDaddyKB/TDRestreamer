# Copy via scripts/configure.py; never commit .env
POSTGRES_PASSWORD=replace-with-generated-administrator-password
TDR_DB_PASSWORD=replace-with-generated-application-password
TDR_ROOT_KEY=replace-with-base64-encoded-32-byte-key
TDR_BOOTSTRAP_TOKEN=replace-with-generated-one-time-token
TDR_METRICS_TOKEN=replace-with-generated-metrics-token
TDR_BIND=127.0.0.1
TDR_PORT=8080
